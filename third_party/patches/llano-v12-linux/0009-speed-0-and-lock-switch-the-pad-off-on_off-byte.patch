From 597ba2f2c8850452a8fe7aa781a7ffbc51767d4a Mon Sep 17 00:00:00 2001
From: Catalin Niculescu <cn.cata@gmail.com>
Date: Sat, 10 Oct 2026 00:47:26 -0700
Subject: [PATCH 9/9] speed 0 and lock switch the pad off (on_off byte)

At 0 % with the pad on, the fan still turns at its slowest, so Off in
Froonty's Fan tab and `lock` left it running. Byte 2 (on_off) = 1 stops
it and puts the lights out with it (confirmed by eye and ear). Software
at 0 % now writes it; any other speed, and release, switch the pad back
on. The status line says "pad off" (and lights off) while it is.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 README.md |  6 +++---
 llano.py  | 16 ++++++++++++----
 2 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/README.md b/README.md
index 1a7e533..71b7b9d 100644
--- a/README.md
+++ b/README.md
@@ -13,7 +13,7 @@ Neither needs any dependencies beyond Python 3.10+ and access to the pad's `/dev
 ```bash
 python3 llano.py status          # speed 60% (pad control)  lights on  raw 88 3c 00 03 04 00 ff 35
 python3 llano.py speed 100       # software control, fan at 100 %
-python3 llano.py speed 0         # fan off
+python3 llano.py speed 0         # the pad off (fan and lights)
 python3 llano.py release         # hand speed control back to the pad's roller
 python3 llano.py lock            # panic: fan off, and every program using Pad is refused
 python3 llano.py unlock          # back to the speed and control from before the lock
@@ -81,7 +81,7 @@ It leaves the pad alone until the smoothed CPU package temperature reaches `--hi
 
 ### Fan recommendation table
 
-`fan_lut.json` gives a fan speed for the CPU and the GPU temperatures; Froonty's Fan tab shows it with an Apply button. It comes from a load × fan sweep on this laptop (i9-13980HX, RTX 4080 Laptop GPU): each device from full load down to idle (100/70/40/20/0 %, idle under 5 % utilization), the pad at 100/60/30/0 % at each load, 60 s to settle and 45 s measured (`research/lut_sweep_2026-10-09.csv`, 82 min).
+`fan_lut.json` gives a fan speed for the CPU and the GPU temperatures; Froonty's Fan tab shows it with an Apply button. It comes from a load × fan sweep on this laptop (i9-13980HX, RTX 4080 Laptop GPU): each device from full load down to idle (100/70/40/20/0 %, idle under 5 % utilization), the pad at 100/60/30/0 % at each load, 60 s to settle and 45 s measured (`research/lut_sweep_2026-10-09.csv`, 82 min). Its 0 % predates `speed 0` switching the pad off: the fan turned at its slowest then, it was not stopped.
 
 ```bash
 nvcc -O3 -Xcompiler -U_GNU_SOURCE -o research/gpu_stress research/gpu_stress.cu   # CUDA load generator
@@ -122,7 +122,7 @@ Set-state fields, from the vendor's `SetLapFanParam` builder:
 |---|---|---|
 | 0 | `fan_mode_control` | `0` = the pad keeps its own speed and ignores byte 1; `1` = byte 1 sets the speed |
 | 1 | `fan_speed` | 0–100 % |
-| 2 | `on_off` | `0` while on |
+| 2 | `on_off` | `0` on; `1` switches the whole pad off, fan and lights. At 0 % with the pad on, the fan still turns at its slowest, so `llano.py speed 0` (and `lock`) also switch it off |
 | 3 | `light_mode \| light_off << 7` | e.g. `03` = colour chase, `83` = same mode with the lights off |
 | 4–6 | lighting parameters | the app sends `04 00 ff` (brightness 255 is byte 6) |
 | 7 | checksum | `~sum(bytes 0–6) & 0xff` |
diff --git a/llano.py b/llano.py
index 6f8ae01..7f93d02 100644
--- a/llano.py
+++ b/llano.py
@@ -7,13 +7,14 @@ sum to 0xFF (byte 7 = ~sum of bytes 0-6).
   ctl speed on_off light 04 00 ff cks    set state
       ctl:   fan_mode_control; 0 = pad keeps its own speed, 1 = software sets speed
       speed: fan_speed 0-100 %
+      on_off: 0 = on, 1 = the whole pad off, fan and lights (0 % alone leaves the fan turning)
       light: light_mode | light_off << 7; bytes 4-6 are the remaining light parameters
   80 00 00 00 00 00 00 7f                request status; GET_FEATURE then returns
   st speed on_off light 04 00 ff cks     status (st 0x88 under pad control, 0x80 under software)
   81 00 00 00 00 00 00 7e                request version; answered on the interrupt IN endpoint
 
   python3 llano.py status
-  python3 llano.py speed 0-100     # take software control and set the fan speed
+  python3 llano.py speed 0-100     # take software control and set the fan speed (0: the pad off)
   python3 llano.py release         # hand speed control back to the pad's buttons
   python3 llano.py lock            # fan off; every Pad write is refused until unlock
   python3 llano.py unlock          # back to the speed and control from before the lock
@@ -44,6 +45,9 @@ import noise
 
 VID, PID = 0x374A, 0xB101
 CTL_PAD, CTL_SOFTWARE = 0x00, 0x01
+# Byte 2. 0 % with the pad on still turns the fan at its slowest; only `off` stops it,
+# and it puts the lights out with it (confirmed by eye and ear, 2026-10-10).
+PAD_ON, PAD_OFF = 0x00, 0x01
 
 
 class LlanoError(Exception):
@@ -164,8 +168,10 @@ class Pad:
                      requested: int | None = None) -> None:
         if not unlocked and read_lock() is not None:
             raise LlanoLocked('the pad is locked off (llano.py unlock to start it again)')
-        cur = self.status()  # keep on/off and lighting as they are
-        self._set_feature(command(bytes([ctl, speed, cur[2], cur[3], cur[4], cur[5], cur[6]])))
+        cur = self.status()  # keep the lighting as it is
+        # Software at 0 % switches the pad off; any speed, or the roller, switches it on.
+        power = PAD_OFF if ctl == CTL_SOFTWARE and speed == 0 else PAD_ON
+        self._set_feature(command(bytes([ctl, speed, power, cur[3], cur[4], cur[5], cur[6]])))
         log_control(action, speed, requested)
 
     def set_speed(self, pct: int, action: str = 'speed') -> int:
@@ -217,7 +223,9 @@ class Pad:
 def describe(rep: bytes) -> str:
     """The status line, then a `noise {json}` line: rpm and dB estimates and the limit in force."""
     ctl = 'software' if rep[0] == 0x80 else 'pad'
-    line = f'speed {rep[1]}% ({ctl} control)  lights {"off" if rep[3] & 0x80 else "on"}  raw {rep.hex(" ")}'
+    lights = 'off' if rep[3] & 0x80 or rep[2] == PAD_OFF else 'on'
+    power = '  pad off' if rep[2] == PAD_OFF else ''
+    line = f'speed {rep[1]}% ({ctl} control){power}  lights {lights}  raw {rep.hex(" ")}'
     return line + '\nnoise ' + json.dumps(noise.describe(rep[1]))
 
 
