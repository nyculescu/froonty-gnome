+"""Fan recommendation LUT from a load x fan sweep (research/lut_sweep.py's CSV).
+
+For each device and load: the recommended fan speed is the slowest one that cools within
+MARGIN_C of the coolest speed measured at that load, without more than THROTTLE_PCT points
+of extra thermal throttling. Its row is the temperature the device runs at with that speed
+(so the LUT is read with the temperature as it is) and that speed. Rows are sorted by
+temperature and made non-decreasing in speed. Between rows the speed is interpolated;
+outside them it is the nearest row's (see recommend()).
+
+The recommendation for the machine is the higher of the CPU's and the GPU's, so whichever
+device is further up its own curve leads.
+
+    python3 research/build_lut.py research/lut_sweep_DATE.csv [fan_lut.json]
+"""
+import csv
+import datetime
+import json
+import sys
+from collections import defaultdict
+from pathlib import Path
+
+MARGIN_C = 1.5
+THROTTLE_PCT = 2.0
+
+
+def device_rows(cells):
+    """[(temp, fan)] for one device's cells, monotone; and the per-load reasoning."""
+    by_load = defaultdict(list)
+    for c in cells:
+        by_load[c['load']].append(c)
+    rows, notes = [], []
+    for load in sorted(by_load, reverse=True):
+        runs = by_load[load]
+        best = min(runs, key=lambda c: (c['temp'], -c['fan']))
+        good = [c for c in runs if c['temp'] <= best['temp'] + MARGIN_C
+                and c['throttle_pct'] <= best['throttle_pct'] + THROTTLE_PCT]
+        pick = min(good, key=lambda c: c['fan'])
+        rows.append((pick['temp'], pick['fan']))
+        spread = max(c['temp'] for c in runs) - best['temp']
+        notes.append({'load': load, 'fan': pick['fan'], 'temp': pick['temp'],
+                      'coolest': best['temp'], 'fan_spread_c': round(spread, 1)})
+    rows.sort()
+    monotone, top = [], 0
+    for temp, fan in rows:
+        top = max(top, fan)
+        monotone.append([temp, top])
+    return monotone, notes
+
+
+def recommend(lut, temps):
+    """{'fan', 'device'} for {device: temperature}: the highest of the devices' speeds."""
+    best = None
+    for device, temp in temps.items():
+        rows = lut['devices'].get(device, {}).get('rows')
+        if not rows or temp is None:
+            continue
+        if temp <= rows[0][0]:
+            fan = rows[0][1]
+        elif temp >= rows[-1][0]:
+            fan = rows[-1][1]
+        else:
+            for (t0, f0), (t1, f1) in zip(rows, rows[1:]):
+                if t0 <= temp <= t1:
+                    fan = f0 + (f1 - f0) * (temp - t0) / (t1 - t0) if t1 > t0 else max(f0, f1)
+                    break
+        if best is None or fan > best['fan']:
+            best = {'fan': round(fan), 'device': device}
+    return best
+
+
+def main():
+    if len(sys.argv) < 2:
+        sys.exit(__doc__)
+    source = Path(sys.argv[1])
+    target = Path(sys.argv[2]) if len(sys.argv) > 2 else Path(__file__).resolve().parent.parent / 'fan_lut.json'
+    cells = defaultdict(list)
+    with open(source) as f:
+        for row in csv.DictReader(f):
+            cells[row['device']].append({
+                'load': int(row['load']), 'fan': int(row['fan']), 'temp': float(row['temp']),
+                'throttle_pct': float(row['throttle_pct'] or 0),
+            })
+    lut = {
+        'source': source.name,
+        'built': datetime.date.today().isoformat(),
+        'rule': f'slowest fan within {MARGIN_C} °C of the coolest at each load, '
+                f'at most {THROTTLE_PCT} points more throttling; the higher of the devices leads',
+        'devices': {},
+    }
+    for device, device_cells in cells.items():
+        rows, notes = device_rows(device_cells)
+        lut['devices'][device] = {'rows': rows, 'loads': notes}
+    target.write_text(json.dumps(lut, indent=1) + '\n')
+    print(json.dumps(lut, indent=1))
+    print(f'wrote {target}')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/research/gpu_stress.cu b/research/gpu_stress.cu
new file mode 100644
index 0000000..e3ca6c1
--- /dev/null
+++ b/research/gpu_stress.cu
@@ -0,0 +1,96 @@
+// GPU load at a chosen duty cycle, for research/lut_sweep.py.
+//
+// A compute-bound kernel (eight independent FMA chains per thread, enough blocks for every SM)
+// runs in short launches for DUTY % of each 100 ms period; the GPU idles for the rest.
+// About 113 W on an RTX 4080 Laptop GPU. A concurrent memory-bound copy lowered that to 88 W
+// (each round waited for the copy), so there is none.
+// nvidia-smi's utilization.gpu is the share of time a kernel runs, so it follows DUTY.
+// Runs until SECONDS have passed, or forever with 0; stops cleanly on SIGTERM/SIGINT.
+//
+//   nvcc -O3 -Xcompiler -U_GNU_SOURCE -o research/gpu_stress research/gpu_stress.cu
+//   (-U_GNU_SOURCE: glibc 2.43 and CUDA 13.0 declare rsqrtf differently)
+//   research/gpu_stress DUTY [SECONDS]
+#include <chrono>
+#include <csignal>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+
+#include <cuda_runtime.h>
+
+static volatile std::sig_atomic_t stop_requested = 0;
+
+static void on_signal(int) { stop_requested = 1; }
+
+#define CHECK(call)                                                                   \
+    do {                                                                              \
+        cudaError_t err = (call);                                                     \
+        if (err != cudaSuccess) {                                                     \
+            std::fprintf(stderr, "%s: %s\n", #call, cudaGetErrorString(err));         \
+            return 1;                                                                 \
+        }                                                                             \
+    } while (0)
+
+__global__ void burn(float *out, int iters) {
+    float a = threadIdx.x * 1e-4f, b = 1.0001f, c = 0.9999f, d = 0.5f;
+    float e = 0.25f, f = 0.125f, g = 1.5f, h = blockIdx.x * 1e-5f;
+    for (int i = 0; i < iters; i++) {
+        a = fmaf(a, b, c); b = fmaf(b, c, d); c = fmaf(c, d, e); d = fmaf(d, e, f);
+        e = fmaf(e, f, g); f = fmaf(f, g, h); g = fmaf(g, h, a); h = fmaf(h, a, b);
+    }
+    // Never true in practice; keeps the compiler from dropping the loop.
+    if (a + b + c + d + e + f + g + h == 1234.5f)
+        out[blockIdx.x * blockDim.x + threadIdx.x] = a;
+}
+
+int main(int argc, char **argv) {
+    if (argc < 2) {
+        std::fprintf(stderr, "usage: %s DUTY(0-100) [SECONDS]\n", argv[0]);
+        return 2;
+    }
+    const int duty = std::atoi(argv[1]);
+    const double seconds = argc > 2 ? std::atof(argv[2]) : 0;
+    if (duty < 0 || duty > 100) {
+        std::fprintf(stderr, "duty must be 0-100\n");
+        return 2;
+    }
+    std::signal(SIGTERM, on_signal);
+    std::signal(SIGINT, on_signal);
+
+    cudaDeviceProp prop;
+    CHECK(cudaGetDeviceProperties(&prop, 0));
+    const int threads = 256, blocks = prop.multiProcessorCount * 8;
+    float *out;
+    CHECK(cudaMalloc(&out, sizeof(float) * threads * blocks));
+
+    // About 2 ms per launch, so the duty cycle is followed closely.
+    int iters = 1 << 12;
+    for (;;) {
+        auto t0 = std::chrono::steady_clock::now();
+        burn<<<blocks, threads>>>(out, iters);
+        CHECK(cudaDeviceSynchronize());
+        double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        if (ms >= 2.0 || iters >= (1 << 24))
+            break;
+        iters *= 2;
+    }
+    std::printf("%s: %d SMs, %d blocks x %d threads, %d iterations per launch, duty %d %%\n",
+                prop.name, prop.multiProcessorCount, blocks, threads, iters, duty);
+    std::fflush(stdout);
+
+    const auto start = std::chrono::steady_clock::now();
+    const auto period = std::chrono::milliseconds(100);
+    const auto busy = std::chrono::microseconds(duty * 1000);
+    while (!stop_requested) {
+        const auto cycle = std::chrono::steady_clock::now();
+        if (seconds > 0 && std::chrono::duration<double>(cycle - start).count() >= seconds)
+            break;
+        while (duty > 0 && !stop_requested && std::chrono::steady_clock::now() - cycle < busy) {
+            burn<<<blocks, threads>>>(out, iters);
+            CHECK(cudaDeviceSynchronize());
+        }
+        std::this_thread::sleep_until(cycle + period);
+    }
+    CHECK(cudaFree(out));
+    return 0;
+}
diff --git a/research/lut_sweep.py b/research/lut_sweep.py
new file mode 100644
index 0000000..987951f
--- /dev/null
+++ b/research/lut_sweep.py
@@ -0,0 +1,200 @@
+"""Load x fan sweep for the fan recommendation LUT (fan_lut.json, see build_lut.py).
+
+For each device asked for (gpu, cpu): start at full load, then step the load down to idle
+(utilization under 5 %). At each load, hold the pad at each fan speed, from the fastest
+down, discard the first SETTLE_S and average the next MEASURE_S: the device's temperature,
+the other device's, utilization, power, clocks and thermal throttling.
+
+GPU load: research/gpu_stress (CUDA, a duty cycle of an FMA kernel). CPU load: one
+duty-cycled busy loop per logical CPU. Refuses to start while either is already busy.
+Writes research/lut_sweep_DATE.csv row by row as .partial and renames it when done.
+Always stops the load, puts the fan back to its starting speed and releases the pad. Stops if the GPU reaches GPU_ABORT_C.
+Stop llanod and llano-guard first (they would override the fixed speeds).
+
+    python3 research/lut_sweep.py [gpu] [cpu]
+"""
+import csv
+import datetime
+import multiprocessing as mp
+import os
+import statistics
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+from llano import Pad  # noqa: E402
+from llanod import cpu_temp  # noqa: E402
+
+LOADS = [100, 70, 40, 20, 0]
+FANS = [100, 60, 30, 0]
+SETTLE_S, MEASURE_S, SAMPLE_S, PREHEAT_S = 60, 45, 3, 120
+# Extra settling after each load change: the first fan speed of a lower load otherwise
+# measures the cool-down from the one before (idle at 100 % fan read hotter than at 0 %).
+LOAD_SETTLE_S = 60
+if os.environ.get('LUT_SWEEP_QUICK'):  # a smoke test of the whole run, about a minute per device
+    LOADS, FANS = [100, 0], [100, 0]
+    SETTLE_S, MEASURE_S, SAMPLE_S, PREHEAT_S, LOAD_SETTLE_S = 3, 6, 2, 3, 3
+GPU_ABORT_C = 92
+GPU_STRESS = HERE / 'gpu_stress'
+THROTTLE_MS = Path('/sys/devices/system/cpu/cpu0/thermal_throttle/package_throttle_total_time_ms')
+FIELDS = ['device', 'load', 'fan', 'temp', 'other_temp', 'util', 'power_w', 'clock_mhz', 'throttle_pct']
+
+
+def gpu_sample():
+    out = subprocess.run(['nvidia-smi', '--query-gpu=temperature.gpu,utilization.gpu,power.draw,clocks.sm,'
+                          'clocks_event_reasons.sw_thermal_slowdown,clocks_event_reasons.hw_thermal_slowdown',
+                          '--format=csv,noheader,nounits'], capture_output=True, text=True, check=True).stdout
+    t, util, pw, clk, sw, hw = [x.strip() for x in out.split(',')]
+    return float(t), float(util), float(pw), float(clk), sw == 'Active' or hw == 'Active'
+
+
+def cpu_times():
+    fields = [int(x) for x in Path('/proc/stat').read_text().split('\n')[0].split()[1:]]
+    return sum(fields), fields[3] + fields[4]  # total, idle + iowait
+
+
+def cpu_util(before, after) -> float:
+    total, idle = after[0] - before[0], after[1] - before[1]
+    return 100 * (1 - idle / total) if total else 0.0
+
+
+def mean_clock_mhz() -> float:
+    return statistics.mean(int(p.read_text()) / 1000 for p in
+                           Path('/sys/devices/system/cpu').glob('cpu[0-9]*/cpufreq/scaling_cur_freq'))
+
+
+def burn(duty, stop):
+    """Busy for duty ms of every 100 ms."""
+    x = 0
+    while not stop.is_set():
+        start = time.monotonic()
+        while time.monotonic() - start < duty.value / 1000:
+            for _ in range(2000):
+                x = (x * 1103515245 + 12345) & 0xFFFFFFFF
+        rest = 0.1 - (time.monotonic() - start)
+        if rest > 0:
+            time.sleep(rest)
+
+
+class CpuLoad:
+    def __init__(self):
+        self.duty, self.stop = mp.Value('i', 0), mp.Event()
+        self.procs = [mp.Process(target=burn, args=(self.duty, self.stop), daemon=True)
+                      for _ in range(os.cpu_count())]
+
+    def set(self, load):
+        if load and not self.procs[0].is_alive():
+            for p in self.procs:
+                p.start()
+        self.duty.value = load
+
+    def close(self):
+        self.stop.set()
+        for p in self.procs:
+            if p.is_alive():
+                p.join(5)
+
+
+class GpuLoad:
+    def __init__(self):
+        self.proc = None
+
+    def set(self, load):
+        self.close()
+        if load:
+            self.proc = subprocess.Popen([str(GPU_STRESS), str(load)], stdout=subprocess.DEVNULL)
+
+    def close(self):
+        if self.proc:
+            self.proc.terminate()
+            self.proc.wait(10)
+            self.proc = None
+
+
+def check_idle():
+    before = cpu_times()
+    time.sleep(3)
+    util = cpu_util(before, cpu_times())
+    gpu = gpu_sample()[1]
+    if util > 10 or gpu > 10:
+        sys.exit(f'not idle: CPU {util:.0f} %, GPU {gpu:.0f} %; stop other work first')
+
+
+def measure(device, seconds):
+    temps, others, utils, powers, clocks, throttled = [], [], [], [], [], 0
+    t0, cpu0, thr0 = time.monotonic(), cpu_times(), int(THROTTLE_MS.read_text())
+    while time.monotonic() - t0 < seconds:
+        if device == 'gpu':
+            t, util, pw, clk, thr = gpu_sample()
+            if t >= GPU_ABORT_C:
+                raise RuntimeError(f'GPU at {t:.0f} °C, aborting')
+            temps.append(t), utils.append(util), powers.append(pw), clocks.append(clk)
+            others.append(cpu_temp())
+            throttled += thr
+        else:
+            temps.append(cpu_temp()), clocks.append(mean_clock_mhz())
+        time.sleep(SAMPLE_S)
+    elapsed = time.monotonic() - t0
+    if device == 'gpu':
+        util, power, throttle = statistics.mean(utils), statistics.mean(powers), 100 * throttled / len(temps)
+        other = statistics.mean(others)
+    else:
+        util, power, other = cpu_util(cpu0, cpu_times()), '', ''
+        throttle = 100 * (int(THROTTLE_MS.read_text()) - thr0) / (elapsed * 1000)
+    r = lambda v: round(v, 1) if v != '' else ''
+    return [r(statistics.mean(temps)), r(other), r(util), r(power), round(statistics.mean(clocks)), r(throttle)]
+
+
+def main():
+    devices = sys.argv[1:] or ['gpu', 'cpu']
+    if any(d not in ('gpu', 'cpu') for d in devices):
+        sys.exit(__doc__)
+    if 'gpu' in devices and not GPU_STRESS.exists():
+        sys.exit(f'build {GPU_STRESS} first (see gpu_stress.cu)')
+    check_idle()
+    out = HERE / f'lut_sweep_{datetime.date.today()}.csv'
+    partial = out.with_suffix('.csv.partial')
+    cells = len(devices) * len(LOADS) * len(FANS)
+    per_device = PREHEAT_S + (len(LOADS) - 1) * LOAD_SETTLE_S
+    print(f'{cells} cells, about {(cells * (SETTLE_S + MEASURE_S) + len(devices) * per_device) / 60:.0f} min',
+          flush=True)
+    with Pad() as pad, open(partial, 'w', newline='') as f:
+        start_speed = pad.status()[1]
+        writer = csv.writer(f)
+        writer.writerow(FIELDS)
+        try:
+            for device in devices:
+                load = GpuLoad() if device == 'gpu' else CpuLoad()
+                try:
+                    load.set(LOADS[0])
+                    pad.set_speed(FANS[0])
+                    print(f'{device}: preheating {PREHEAT_S} s', flush=True)
+                    time.sleep(PREHEAT_S)
+                    for level in LOADS:
+                        load.set(level)
+                        if level != LOADS[0]:
+                            pad.set_speed(FANS[0])
+                            time.sleep(LOAD_SETTLE_S)
+                        for fan in FANS:
+                            pad.set_speed(fan)
+                            time.sleep(SETTLE_S)
+                            row = [device, level, fan, *measure(device, MEASURE_S)]
+                            writer.writerow(row)
+                            f.flush()
+                            print(' '.join(f'{k}={v}' for k, v in zip(FIELDS, row)), flush=True)
+                finally:
+                    load.close()
+        finally:
+            pad.set_speed(start_speed)  # release keeps the current speed
+            pad.release()
+    if os.environ.get('LUT_SWEEP_QUICK'):
+        out = out.with_name(out.stem + '_quick.csv')
+    partial.rename(out)
+    print(f'wrote {out}', flush=True)
+
+
+if __name__ == '__main__':
+    main()
