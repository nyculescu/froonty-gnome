froonty@catalin/schemas/gschemas.compiled
# Packages built by the old public build (make pack), if any are left
dist/

# Ignore all files in the docs/local/ directory
docs/local/

# Logo artwork (kept out of the repository)
logo/

# Python bytecode (the Python helpers' tests)
__pycache__/

# The Formulas tab's renderer, fetched by tools/fetch-mathjax.py (make mathjax)
froonty@catalin/third_party/mathjax/
froonty@catalin/third_party/mathjax.old/
froonty@catalin/third_party/.mathjax-fetch.*

# The Break tab's exercise pictures (WorkoutLabs', all rights reserved by
# WorkoutLabs), fetched by tools/fetch-break-art.py (make break-art)
froonty@catalin/third_party/break-art/
froonty@catalin/third_party/.break-art.*

# The Break tab's Garmin helper keeps its sign-in tokens and venv under
# ~/.local/share/froonty/garmin, outside the repository; these lines only
# make sure such files could never be committed from here by mistake.
garmin_tokens*.json
**/froonty/garmin/
